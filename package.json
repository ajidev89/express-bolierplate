{
    "name": "scraply",
    "version": "1.0.0",
    "description": "",
    "main": "app.js",
    "scripts": {
        "start": "node build/app.js",
        "build": "node scripts/use-database.js generate && tspc && copyfiles -u 1 src/views/**/* build/",
        "dev": "node scripts/use-database.js generate && nodemon --exec ts-node -r tsconfig-paths/register src/app.ts",
        "db:generate": "node scripts/use-database.js generate",
        "db:push": "node scripts/use-database.js push",
        "docker:up": "node scripts/docker-up.js up --build",
        "docker:down": "node scripts/docker-up.js down",
        "postinstall": "node scripts/use-database.js generate"
    },
    "husky": {
        "hooks": {
            "pre-commit": "npm test",
            "pre-push": "npm run build"
        }
    },
    "keywords": [],
    "author": "Scarply",
    "license": "ISC",
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/ejs": "^3.1.5",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.14.10",
        "@types/nodemailer": "^6.4.16",
        "copyfiles": "^2.4.1",
        "husky": "^9.1.6",
        "nodemon": "^3.1.4",
        "ts-node": "^10.9.2",
        "ts-patch": "^3.2.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.5.3",
        "typescript-transform-paths": "^3.5.1"
    },
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "bcryptjs": "^2.4.3",
        "body-parser": "^1.20.2",
        "cors": "^2.8.5",
        "dayjs": "^1.11.13",
        "dotenv": "^16.4.5",
        "ejs": "^3.1.10",
        "express": "^4.19.2",
        "joi": "^17.13.3",
        "jsonwebtoken": "^9.0.2",
        "module-alias": "^2.2.3",
        "morgan": "^1.10.0",
        "nodemailer": "^6.9.15",
        "prisma": "^6.19.3",
        "winston": "^3.13.0"
    }
}
