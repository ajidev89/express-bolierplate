FRONTEND_URL=

# Mail
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USERNAME=
MAIL_PASSWORD=

# CONFIG
# mongodb, postgresql, or mysql. After changing this, run: npm run db:generate && npm run db:push
DB_PROVIDER=mongodb
# container: Compose starts the matching database image.
# existing: connect to a database that is already running.
# Switch with these two values, then run: npm run docker:up
DB_SOURCE=existing
# Credentials for the Compose Postgres and MySQL images.
DB_USER=app
DB_PASSWORD=secret
DB_NAME=app
DB_ROOT_PASSWORD=rootsecret
# true runs prisma db push when the app container starts. Use true when DB_SOURCE=container.
DB_PUSH=false
# App on your machine, existing database:
#   mongodb://localhost:27017/yourDatabase
#   postgresql://USER:PASSWORD@localhost:5432/yourDatabase?schema=public
#   mysql://USER:PASSWORD@localhost:3306/yourDatabase
# App in Docker, database on your machine (host.docker.internal):
#   mongodb://host.docker.internal:27017/yourDatabase
#   postgresql://USER:PASSWORD@host.docker.internal:5432/yourDatabase?schema=public
#   mysql://USER:PASSWORD@host.docker.internal:3306/yourDatabase
# App and database both in Docker (DB_SOURCE=container). Host is the service name:
#   mongodb://mongodb:27017/app
#   postgresql://app:secret@postgresql:5432/app?schema=public
#   mysql://app:secret@mysql:3306/app
DATABASE_URL=
PORT=3000
TOKEN_SECRET="EncryptALLdataAlways"
TOKEN_DURATION="1h"

# CLOUDINARY
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=